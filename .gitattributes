# This repo is consumed on Linux. Never let Windows checkouts inject CRLF —
# a shell script with CRLF fails with "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

*.sh    text eol=lf
*.zsh   text eol=lf
*.bash  text eol=lf
*.lua   text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.conf  text eol=lf
*.tmpl  text eol=lf
*.json  text eol=lf

*.png   binary
*.jpg   binary
*.zip   binary
*.ttf   binary
*.otf   binary

# Brave's Bookmarks file is copied byte-for-byte into the profile on first run.
# Git must not normalise its line endings — keep it exactly as exported.
home/dot_config/brave/bookmarks.json -text
