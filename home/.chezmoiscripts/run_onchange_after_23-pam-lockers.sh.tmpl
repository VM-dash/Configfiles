{{ template "lib.sh" . }}
{{ template "gui-only.sh" . }}
{{- if not (or (eq .desktop "hyprland") (and (hasKey . "hyprland") .hyprland)) }}
exit 0
{{- end }}

# PAM "login" stack: password first, fingerprint only as a fallback.
#
# Noctalia's lock screen checks the password against the hard-coded PAM
# service "login" (src/shell/lockscreen/lock_screen.cpp) while it drives the
# fingerprint reader itself over D-Bus. Fedora's system-auth (authselect
# with-fingerprint) lists pam_fprintd BEFORE pam_unix, so the typed password
# is only verified after pam_fprintd fought Noctalia for the sensor and gave
# up on a D-Bus timeout — a minute-long unlock. Only "login" is touched
# (TTY logins and the locker); sudo and GDM keep using system-auth as is.
# The file is otherwise util-linux's stock one, so it must be revisited if a
# util-linux update drops a login.rpmnew.
#
# Submit an EMPTY password to fall through to the fingerprint reader
# (Noctalia's allow_empty_password must be on for that; off by default).

step "PAM: login stack — password first, fingerprint fallback"

if ! can_root; then
	warn "no sudo — skipping /etc/pam.d/login"
	exit 0
fi

# Leftover from the first attempt (Noctalia never reads it).
if [ -f /etc/pam.d/noctalia ]; then
	$SUDO rm -f /etc/pam.d/noctalia && ok "removed unused /etc/pam.d/noctalia"
fi

want="$(cat <<-'PAM'
	#%PAM-1.0
	# Managed by chezmoi (.chezmoiscripts/23-pam-lockers): the auth section is
	# password-first (pam_unix before pam_fprintd); the rest is util-linux's.
	auth       required     pam_env.so
	auth       required     pam_faildelay.so delay=2000000
	auth       sufficient   pam_unix.so try_first_pass nullok
	auth       sufficient   pam_fprintd.so
	auth       required     pam_deny.so
	auth       include      postlogin
	account    required     pam_nologin.so
	account    include      system-auth
	password   include      system-auth
	# pam_selinux.so close should be the first session rule
	session    required     pam_selinux.so close
	session    required     pam_loginuid.so
	# pam_selinux.so open should only be followed by sessions to be executed in the user context
	session    required     pam_selinux.so open
	session    required     pam_namespace.so
	session    optional     pam_keyinit.so force revoke
	session    include      system-auth
	session    include      postlogin
	-session   optional     pam_ck_connector.so
	PAM
)"

if [ "$(cat /etc/pam.d/login 2>/dev/null)" = "$want" ]; then
	ok "/etc/pam.d/login up to date"
else
	[ -f /etc/pam.d/login.orig ] || $SUDO cp /etc/pam.d/login /etc/pam.d/login.orig
	printf '%s\n' "$want" | $SUDO tee /etc/pam.d/login >/dev/null \
		&& ok "/etc/pam.d/login written (stock copy kept as login.orig)" \
		|| warn "could not write /etc/pam.d/login"
fi
