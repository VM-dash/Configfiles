{{ template "lib.sh" . }}
{{ template "gui-only.sh" . }}
{{- if not (eq .chezmoi.osRelease.id "fedora") }}
exit 0
{{- end }}

# Parachord — music player. Upstream ships a plain RPM per release (no repo),
# so dnf cannot update it: bump parachord_rev to get a newer one.
# rev: {{ .externals.parachord_rev }}

REV="{{ .externals.parachord_rev }}"
URL="https://github.com/{{ .externals.parachord_repo }}/releases/download/$REV/parachord-desktop-${REV#v}.x86_64.rpm"

step "Parachord $REV"

if rpm -q "parachord-desktop-${REV#v}" >/dev/null 2>&1; then
	ok "already installed"
	exit 0
fi

can_root || { warn "no sudo — skipping"; exit 0; }
try $SUDO dnf install -y "$URL"
