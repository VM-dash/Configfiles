{{ template "lib.sh" . }}
{{ template "gui-only.sh" . }}

# Passenger — C#/.NET IDE (passenger-ide.net). Upstream ships a tarball with
# its own install.sh (per-user: ~/.local/opt + ~/.local/bin + desktop entry),
# no repo or package. Bump passenger_rev to update.
# rev: {{ .externals.passenger_rev }}

REV="{{ .externals.passenger_rev }}"
URL="https://github.com/{{ .externals.passenger_repo }}/releases/download/$REV/Passenger-linux-x64.tar.gz"
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/kd/passenger.rev"

step "Passenger $REV"

if [ "$(cat "$STAMP" 2>/dev/null)" = "$REV" ] && has passenger; then
	ok "already installed"
	exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if ! curl -fsSL "$URL" | tar xz -C "$tmp"; then
	warn "download failed — skipping"
	exit 0
fi

if try "$tmp/passenger/install.sh"; then
	mkdir -p "$(dirname "$STAMP")"
	printf '%s\n' "$REV" > "$STAMP"
	ok "passenger installed"
fi
