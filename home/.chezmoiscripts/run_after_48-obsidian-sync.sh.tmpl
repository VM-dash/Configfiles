{{ template "lib.sh" . }}

step "KD-Obsidian OneDrive sync"

CONF="${XDG_CONFIG_HOME}/rclone/obsidian.conf"

if ! has_systemd || is_container; then
	info "no systemd — skip kd-obsidian-sync.timer"
	exit 0
fi

systemctl --user daemon-reload

if [ ! -f "$CONF" ]; then
	warn "no $CONF — timer not enabled"
	warn "  rclone config --config $CONF"
	warn "  then: kd-obsidian-sync --resync && systemctl --user enable --now kd-obsidian-sync.timer"
	exit 0
fi

try systemctl --user enable --now kd-obsidian-sync.timer
ok "kd-obsidian-sync.timer enabled"
