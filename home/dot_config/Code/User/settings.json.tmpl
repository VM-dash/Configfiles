{
  // Managed by chezmoi — edits made through the VS Code settings UI are
  // reverted on the next `chezmoi apply`. Change this file instead:
  //   chezmoi edit --apply ~/.config/Code/User/settings.json
  // Font family and sizes come from .chezmoidata/fonts.yaml.

  // ------------------------------------------------------------- fonts --
  "editor.fontFamily": "'{{ .font.mono }}', '{{ .font.mono_fallback }}', monospace",
  "editor.fontSize": {{ .font.size_editor_px }},
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,

  "terminal.integrated.fontFamily": "'{{ .font.mono }}', monospace",
  "terminal.integrated.fontSize": {{ .font.size_terminal_px }},

  "debug.console.fontFamily": "'{{ .font.mono }}', monospace",
  "debug.console.fontSize": {{ .font.size_terminal_px }},

  "scm.inputFontFamily": "editor",
  "chat.editor.fontFamily": "'{{ .font.mono }}', monospace",
  "notebook.output.fontFamily": "'{{ .font.mono }}', monospace",
  "markdown.preview.fontFamily": "'{{ .font.sans }}', system-ui, sans-serif",

  // ----------------------------------------------------------- terminal --
  // Use the login shell so mise shims, aliases and the theme exports are all
  // present in the integrated terminal.
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "{{ lookPath "zsh" | default "/usr/bin/zsh" }}",
      "args": ["-l"]
    }
  },

  // -------------------------------------------------------------- theme --
  // VS Code follows GNOME light/dark: autoDetectColorScheme picks between
  // the preferred dark/light colour themes below, and `theme` rewrites the
  // slot matching the chosen theme's polarity (it also flips GNOME to that
  // polarity, which is what makes the switch visible immediately).
  // Icons are catppuccin-mocha (dark) / catppuccin-latte (light), kept in
  // step with GNOME by kd-vscode-icon-sync.service — `theme` never touches
  // them, so they don't change with the theme family, only with light/dark.
  // Requires Catppuccin.catppuccin-vsc, Catppuccin.catppuccin-vsc-icons,
  // mvllow.rose-pine.
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Catppuccin Mocha",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "catppuccin-mocha",

  // ------------------------------------------------------------- editor --
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [120],
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  // ---------------------------------------------------------------- git --
  "git.autofetch": true,
  "git.confirmSync": false,

  "telemetry.telemetryLevel": "off",
  "update.mode": "none",

  // ------------------------------------------------------------- window --
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.titleBar.signIn.enabled": false
}
