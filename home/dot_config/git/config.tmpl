[user]
	name = {{ .name }}
	email = {{ .email }}

[init]
	defaultBranch = main

[core]
	pager = delta
	editor = nvim
	autocrlf = input

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	# delta follows BAT_THEME, which `theme` exports — so diffs match whatever
	# colour scheme is active without any extra wiring.

[merge]
	conflictstyle = zdiff3
	tool = nvimdiff

[diff]
	colorMoved = default
	algorithm = histogram

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = current

[rebase]
	autoStash = true

[fetch]
	prune = true

[rerere]
	enabled = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[alias]
	st = status --short --branch
	co = checkout
	sw = switch
	br = branch
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
	last = log -1 HEAD --stat
	unstage = restore --staged

[include]
	# Machine-specific overrides (proxies, credentials) — untracked.
	path = ~/.config/git/local

# Per-directory identities — the LAST matching include wins, so the more
# specific directory must come after the more general one.
#
#   ~/Documents/kardham/**        Azure DevOps   vmasson@kardham-digital.com
#   ~/Documents/kardham/tools/**  GitHub         VM-dash
#   ~/Documents/perso/**          GitHub         victormasson
#
# gitdir: matches with symlinks RESOLVED, so ~/.local/share/chezmoi (a
# symlink into kardham/tools) still gets the VM-dash identity.
[includeIf "gitdir:~/Documents/kardham/"]
	path = ~/.config/git/config-kardham
[includeIf "gitdir:~/Documents/kardham/tools/"]
	path = ~/.config/git/config-vmdash
[includeIf "gitdir:~/Documents/perso/"]
	path = ~/.config/git/config-perso
