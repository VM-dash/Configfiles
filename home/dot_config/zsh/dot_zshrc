export EDITOR=nvim
export VISUAL=nvim

alias '..'='cd ..'
alias '...'='cd ../..'
alias '....'='cd ../../..'
alias '.....'='cd ../../../..'

# eza comes from mise. Fall back to coreutils ls if it is not installed yet,
# so a half-provisioned machine still has a usable shell.
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --color=always --group-directories-first --icons'
  alias ll='eza -la --icons --octal-permissions --group-directories-first'
  alias tree='eza --tree --level=2 --color=always --group-directories-first --icons'
else
  alias ls='ls --color=auto --group-directories-first'
  alias ll='ls -la --color=auto --group-directories-first'
fi

## Open with current path
# Original version used `wslpath`, which only exists under WSL. On Linux the
# portable equivalent is OSC 7: it tells the terminal (Ghostty, and most
# others) the current directory, so a new tab or split opens in the same place.
keep_current_path() {
  printf '\e]7;file://%s%s\e\\' "${HOST:-$HOSTNAME}" "$PWD"
}
precmd_functions+=(keep_current_path)

########################################
# Added for this machine
########################################

# --- PATH -------------------------------------------------------------------
# typeset -U keeps PATH deduplicated: .zshrc is re-sourced by nested shells and
# by `exec zsh` (which `theme` tells you to run), and duplicates accumulate.
typeset -U path PATH
export PATH=$HOME/.local/bin:$PATH

# --- mise: dev toolchain (node, dotnet, neovim, tmux, cli tools) ------------
# Must come before anything that *runs* a mise-managed tool at startup:
# `mise activate` is what puts ~/.local/share/mise/installs/*/ on PATH, and
# starship below is one of those installs.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# --- Prompt ------------------------------------------------------------------
# `starship init zsh` prints a stub that then re-runs starship with
# --print-full-init, so the plain form executes the binary twice on every
# shell start. Going straight to the full init is byte-identical and halves it.
#
# Guarded: an unguarded eval on a half-provisioned machine prints "command not
# found" and silently leaves you on zsh's default prompt, which reads as
# "starship is broken" rather than "starship is not on PATH yet".
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh --print-full-init)"
fi

# --- Colours from the active theme ------------------------------------------
# Written by `theme`; sets BAT_THEME, FZF_DEFAULT_OPTS, THEME_NAME, ...
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/theme/current.sh" ]] \
  && source "${XDG_CONFIG_HOME:-$HOME/.config}/theme/current.sh"

# --- zoxide: smarter cd ------------------------------------------------------
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias cd='z'
fi

# --- fzf: Ctrl-R history search, Ctrl-T file search --------------------------
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh) 2>/dev/null || true
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
fi

# --- Convenience -------------------------------------------------------------
alias v='nvim'
alias lg='lazygit'
alias g='git'
alias dc='docker compose'
alias cm='chezmoi'
alias cme='chezmoi edit --apply'
alias cma='chezmoi apply'

# `mkcd foo/bar` — make a directory and enter it.
mkcd() { mkdir -p "$1" && cd "$1"; }

# --- Local, untracked overrides ---------------------------------------------
# Machine-specific secrets and tweaks that must not go in the git repo.
[[ -r "$ZDOTDIR/local.zsh" ]] && source "$ZDOTDIR/local.zsh"
