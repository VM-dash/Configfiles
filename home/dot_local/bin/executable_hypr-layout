#!/bin/bash
# Switch the tiling layout of the CURRENT workspace at runtime (Super+T).
#   hypr-layout            toggle scrolling <-> master
#   hypr-layout <name>     set explicitly (scrolling|master|dwindle)
#   hypr-layout get        print the current one
# Every workspace is pinned to scrolling by rule in hyprland.lua; this sets a
# runtime workspace rule on top, so it lasts until the next config reload.
set -euo pipefail
ws=$(hyprctl activeworkspace -j | jq -r .id)
cur=$(hyprctl activeworkspace -j | jq -r .tiledLayout)
case "${1:-toggle}" in
get) echo "$cur"; exit 0 ;;
toggle) [ "$cur" = "scrolling" ] && new=master || new=scrolling ;;
scrolling|master|dwindle) new="$1" ;;
*) echo "usage: hypr-layout [toggle|get|scrolling|master|dwindle]" >&2; exit 2 ;;
esac
hyprctl eval "hl.workspace_rule({ workspace = \"$ws\", layout = \"$new\" })" >/dev/null
notify-send -a hyprland -t 1500 "Workspace $ws: $new" 2>/dev/null || true
echo "$new"
