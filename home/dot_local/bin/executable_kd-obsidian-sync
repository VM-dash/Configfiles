#!/usr/bin/env bash
#
# kd-obsidian-sync — bisync the KD-Obsidian vault to Kardham OneDrive.
#
#   kd-obsidian-sync              two-way sync
#   kd-obsidian-sync --resync     first run (or after a filter change)
#
# Uses a dedicated rclone config so this never touches ~/.config/rclone/rclone.conf.
# Create it once:
#
#   rclone config --config ~/.config/rclone/obsidian.conf
#
# Pick OneDrive, sign in with the Kardham account, and accept the default remote
# name (or any name — this script uses the first remote in that file).
# On Windows, open OneDrive - KARDHAM/KD-Obsidian as the vault.
#
# Managed by chezmoi.

set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/rclone/obsidian.conf"
FILTER="${XDG_CONFIG_HOME:-$HOME/.config}/rclone/obsidian.filter"
VAULT="${KD_OBSIDIAN_VAULT:-$HOME/Documents/kardham/doc/KD-Obsidian}"
REMOTE_PATH="${KD_OBSIDIAN_REMOTE_PATH:-KD-Obsidian}"

if [ -t 1 ]; then
	C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_RESET=$'\033[0m'
else
	C_RED=''; C_YELLOW=''; C_RESET=''
fi

die() { printf '%sfail%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
warn() { printf '%swarn%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }

rclone_bin() {
	if command -v rclone >/dev/null 2>&1; then
		command -v rclone
		return
	fi
	if command -v mise >/dev/null 2>&1 && mise which rclone >/dev/null 2>&1; then
		mise which rclone
		return
	fi
	die "rclone not found — chezmoi apply (mise: rclone@latest)"
}

[ -f "$CONFIG" ] || die "missing $CONFIG
  rclone config --config $CONFIG
  Use the Kardham OneDrive account. Remote path will be $REMOTE_PATH."

[ -d "$VAULT" ] || die "vault not found: $VAULT"

RCLONE="$(rclone_bin)"
REMOTE="$("$RCLONE" listremotes --config "$CONFIG" | head -n1)"
[ -n "$REMOTE" ] || die "no remotes in $CONFIG — run rclone config --config $CONFIG"

FILTER_ARGS=()
[ -f "$FILTER" ] && FILTER_ARGS=(--filters-from "$FILTER")

exec "$RCLONE" bisync "$VAULT" "${REMOTE}${REMOTE_PATH}" \
	--config "$CONFIG" \
	"${FILTER_ARGS[@]}" \
	--create-empty-src-dirs \
	--compare size,modtime \
	--conflict-resolve newer \
	--resilient \
	"$@"
