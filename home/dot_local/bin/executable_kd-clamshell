#!/bin/bash
# Lid handling for the Hyprland session (bound to switch:on/off:Lid Switch).
#   close: turn the laptop panel off, but ONLY when an external monitor is
#          active — undocked, logind's default lid-close suspend handles it,
#          and disabling the only monitor would leave a running black brick.
#   open:  bring the panel back.
set -euo pipefail
case "${1:-}" in
# NOTE: a Lua-configured Hyprland rejects `hyprctl keyword` — runtime changes
# go through `hyprctl eval` instead.
close)
	if hyprctl monitors -j | jq -e '[.[] | select(.name != "eDP-1")] | length > 0' >/dev/null; then
		hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })'
	fi
	;;
open)
	# disabled=false must be explicit — the disable rule persists otherwise.
	hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false, mode = "preferred", position = "auto", scale = "auto" })'
	;;
*)
	echo "usage: kd-clamshell close|open" >&2
	exit 2
	;;
esac
