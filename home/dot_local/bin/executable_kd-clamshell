#!/bin/bash
# Lid handling for the Hyprland session (bound to switch:on/off:Lid Switch).
# All the logic lives in hyprland.lua's KD.apply_layout(): it reads the ACPI
# lid state and only blanks the panel while an external screen is present.
# NOTE: a Lua-configured Hyprland rejects `hyprctl keyword`; runtime changes
# go through `hyprctl eval`.
set -euo pipefail
case "${1:-}" in
close|open)
	sleep 0.5   # let the ACPI state settle before the config reads it
	hyprctl eval 'KD.apply_layout()' >/dev/null
	;;
*)
	echo "usage: kd-clamshell close|open" >&2
	exit 2
	;;
esac
