#!/bin/bash
# Searchable keybinding cheatsheet for the Hyprland/Noctalia session.
# Bound to Super+/ — the list is generated by hyprland.lua itself on every
# config load (~/.cache/hypr-cheatsheet.txt), so it can't drift from the
# actual binds. `hyprctl binds` can't do this: Lua binds all report "__lua".
set -euo pipefail
f="$HOME/.cache/hypr-cheatsheet.txt"
if [ ! -r "$f" ]; then
	command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
	[ -r "$f" ] || { echo "no cheatsheet at $f — is this the Hyprland session?" >&2; exit 1; }
fi
# Selection is meaningless (it's a reference list); ignore it.
noctalia dmenu -p "Keybinds" < "$f" >/dev/null || true
