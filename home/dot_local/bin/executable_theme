#!/usr/bin/env bash
#
# theme — switch the colour scheme of the whole environment at once.
#
#   theme                 interactive picker (fzf, or a numbered menu)
#   theme <name>          switch to a theme
#   theme set <name>      same, explicit
#   theme list            show every available theme
#   theme current         print the active theme
#   theme next            cycle to the next theme in the catalog
#   theme toggle          flip between the last dark and last light theme
#   theme reload          re-apply the current theme (after a config change)
#
# Flags:  --quiet / -q     only print warnings and errors
#
# Covers: Ghostty · tmux · Neovim · druk · VS Code · Zed · Starship · bat ·
#         fzf · delta · GNOME light/dark · Hyprland (stub). Everything that
#         can reload live, does. (VS Code icons are NOT covered on purpose:
#         kd-vscode-icon-sync keeps them on mocha/latte tracking GNOME.)
#
# Managed by chezmoi. The files this script writes are deliberately NOT in the
# chezmoi source state, so switching a theme never conflicts with an apply.

set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_DIR="$CONFIG/theme"
CATALOG="$THEME_DIR/themes.json"
CURRENT_FILE="$THEME_DIR/current"
EXPORTS_FILE="$THEME_DIR/current.sh"
STARSHIP_TEMPLATE="$THEME_DIR/starship.template.toml"

QUIET=0
RELOAD=0

# ------------------------------------------------------------------ output --
if [ -t 1 ]; then
	C_RESET=$'\033[0m'; C_GREEN=$'\033[32m'
	C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
else
	C_RESET=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_DIM=''; C_BOLD=''
fi

say()  { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
info() { [ "$QUIET" -eq 1 ] || printf '%s  ·%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
ok()   { [ "$QUIET" -eq 1 ] || printf '%s  ✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s  !%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%serror%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

has() { command -v "$1" >/dev/null 2>&1; }

# ----------------------------------------------------------------- catalog --
[ -r "$CATALOG" ] || die "theme catalog not found at $CATALOG (run: chezmoi apply)"
has jq || die "jq is required but not installed"

# Load every field of one theme into TH_* shell variables with a SINGLE jq
# pass. The obvious alternative — a field() helper called once per value —
# costs ~15 jq processes per switch, each re-parsing the whole catalog, on a
# path that runs interactively and on every `chezmoi apply`.
# Returns non-zero if the theme is not in the catalog, so it doubles as the
# existence check.
load_theme() {
	local kv
	kv="$(jq -r --arg t "$1" '
		.themes[$t] // empty
		| to_entries[]
		| "TH_\(.key)=\(.value | tostring | @sh)"' "$CATALOG")"
	[ -n "$kv" ] || return 1
	# Clear stale values first: a theme missing an optional key would
	# otherwise inherit it from a previously loaded one.
	unset "${!TH_@}"
	eval "$kv"
}

all_themes() { jq -r '.order[]' "$CATALOG"; }

current_theme() {
	local cur
	# `read` is a builtin; the file is one bare slug written by cmd_set.
	if [ -r "$CURRENT_FILE" ] && read -r cur < "$CURRENT_FILE" && [ -n "$cur" ]; then
		printf '%s' "$cur"
	else
		all_themes | head -n1
	fi
}

# ============================================================================
#  Per-target appliers. Each is independent and non-fatal: a missing tool must
#  never stop the other targets from being themed.
# ============================================================================

# --- Ghostty ----------------------------------------------------------------
# A Ghostty *theme file* is forbidden from setting `theme` or `config-file`,
# so the swap happens through an ordinary config fragment that the main config
# pulls in with `config-file = ?theme.conf`.
apply_ghostty() {
	local t="$1" name="${TH_ghostty:-}"
	[ -n "$name" ] || return 0

	local dir="$CONFIG/ghostty"
	[ -d "$dir" ] || return 0

	cat > "$dir/theme.conf" <<-EOF
		# Generated by \`theme\` — do not edit.
		# Active theme: $t
		theme = $name
	EOF
	ok "ghostty  → $name"

	# Reload running instances. systemd knows the right PID; pkill is a guess,
	# and Ghostty crashes on any signal other than SIGUSR2, so keep it exact.
	if has systemctl && systemctl --user is-active --quiet app-com.mitchellh.ghostty.service 2>/dev/null; then
		systemctl reload --user app-com.mitchellh.ghostty.service 2>/dev/null || true
	elif has pkill; then
		pkill -SIGUSR2 -x ghostty 2>/dev/null || true
	fi
}

# --- tmux -------------------------------------------------------------------
# catppuccin/tmux advises against TPM (name conflicts) while rose-pine/tmux
# expects it, so both are cloned to fixed paths and only the active one is
# sourced from here.
apply_tmux() {
	# The tmux port and variant are always the theme's own family/variant —
	# they used to be duplicated as separate catalog fields for no reason.
	local t="$1" family="${TH_family:-}" variant="${TH_variant:-}"
	[ -n "$family" ] || return 0

	local dir="$CONFIG/tmux"
	[ -d "$dir" ] || return 0

	local plugin_dir="$dir/themes/$family"
	if [ ! -d "$plugin_dir" ]; then
		warn "tmux theme '$family' not cloned yet — run: chezmoi apply"
		return 0
	fi

	# Entry-point filenames differ between the two ports and have changed
	# across releases; resolve it rather than hardcoding.
	local entry=""
	for candidate in "$plugin_dir/$family.tmux" "$plugin_dir/${family}_tmux.tmux"; do
		if [ -f "$candidate" ]; then
			entry="$candidate"
			break
		fi
	done
	if [ -z "$entry" ]; then
		entry="$(find "$plugin_dir" -maxdepth 1 -name '*.tmux' -print -quit 2>/dev/null || true)"
	fi
	[ -n "$entry" ] || { warn "no .tmux entry point in $plugin_dir"; return 0; }

	{
		echo "# Generated by \`theme\` — do not edit."
		echo "# Active theme: $t"
		case "$family" in
			catppuccin)
				echo "set -g @catppuccin_flavor '$variant'"
				echo "set -g @catppuccin_window_status_style 'rounded'"
				;;
			rose-pine)
				echo "set -g @rose_pine_variant '$variant'"
				echo "set -g @rose_pine_host 'on'"
				echo "set -g @rose_pine_directory 'on'"
				echo "set -g @rose_pine_bar_bg_disable 'on'"
				echo "set -g @rose_pine_bar_bg_disabled_color_option 'default'"
				;;
		esac
		echo "run-shell '$entry'"
	} > "$dir/theme.conf"
	ok "tmux     → $family $variant"

	# Reload the whole config so plugin options are re-evaluated in order.
	if has tmux && tmux has-session 2>/dev/null; then
		tmux source-file "$dir/tmux.conf" 2>/dev/null || true
	fi
}

# --- Neovim -----------------------------------------------------------------
# Nothing is generated: Neovim reads themes.json + current itself (see
# lua/config/theme.lua). Only the live instances need poking.
apply_nvim() {
	local t="$1" scheme="${TH_nvim:-}"
	[ -n "$scheme" ] || return 0
	ok "neovim   → $scheme"

	has nvim || return 0

	local runtime="${XDG_RUNTIME_DIR:-/tmp}"
	local found=0
	# Neovim has no "list all instances" command; sockets are enumerated from
	# the runtime dir, named <appname>.<pid>.<counter>.
	for sock in "$runtime"/nvim.*; do
		[ -S "$sock" ] || continue
		found=$((found + 1))
		# <C-\><C-N> forces normal mode first, in case the instance is sitting
		# in insert or terminal mode.
		nvim --server "$sock" --remote-send \
			'<C-\><C-N>:lua pcall(function() require("config.theme").reload() end)<CR>' \
			>/dev/null 2>&1 || true
	done
	[ "$found" -eq 0 ] || info "reloaded $found running Neovim instance(s)"
}

# --- druk -------------------------------------------------------------------
# druk has no include and no RPC. Patch the live config in place so in-editor
# settings survive; seed from the template only when config.json is missing.
# themeSync stays ON (same model as VS Code): druk picks themeDark/themeLight
# from the OS at launch, and apply_gnome flips the OS to the chosen theme's
# polarity — so writing the matching slot here is what makes the switch land.
# `theme` is also written for the current session's next launch; themeSync
# itself is user-owned and never touched. A running instance picks this up on
# the next launch.
apply_druk() {
	local t="$1" name="${TH_druk:-}"
	[ -n "$name" ] || return 0

	local out="$CONFIG/druk/config.json"
	local src="$out"
	[ -r "$src" ] || src="$CONFIG/druk/config.template.json"
	[ -r "$src" ] || return 0

	local polarity="${TH_polarity:-}"
	if ! jq --arg theme "$name" --arg polarity "$polarity" '
		.theme = $theme
		| if $polarity == "light" then .themeLight = $theme
		  elif $polarity == "dark" then .themeDark = $theme
		  else . end
	' "$src" > "$out.new"; then
		warn "druk config failed to render"
		rm -f "$out.new"
		return 0
	fi
	mv -f "$out.new" "$out"
	ok "druk     → $name"
}

# --- Starship ---------------------------------------------------------------
# Starship has no include mechanism, so the whole config is regenerated from a
# template with every palette baked in and one placeholder for the active one.
apply_starship() {
	local t="$1" palette="${TH_starship_palette:-}"
	[ -n "$palette" ] || return 0

	if [ ! -r "$STARSHIP_TEMPLATE" ]; then
		warn "starship template missing at $STARSHIP_TEMPLATE"
		return 0
	fi

	# Write beside the target rather than via mktemp in /tmp, so the rename is
	# a same-filesystem rename(2) instead of a cross-device copy.
	local out="$CONFIG/starship.toml"
	sed "s/@THEME_PALETTE@/$palette/g" "$STARSHIP_TEMPLATE" > "$out.new" \
		&& mv -f "$out.new" "$out"
	ok "starship → $palette"
}

# --- Shell exports (bat, fzf, delta) ----------------------------------------
apply_exports() {
	local t="$1" bat_theme="${TH_bat:-}"
	local fzf_opts="${TH_fzf:-}" polarity="${TH_polarity:-}" label="${TH_label:-}"

	# bat renames themes between releases; fall back rather than silently
	# rendering everything in the default scheme.
	if has bat && [ -n "$bat_theme" ]; then
		if ! bat --list-themes 2>/dev/null | grep -qxF "$bat_theme"; then
			warn "bat theme '$bat_theme' not found (run: bat cache --build) — using ansi"
			bat_theme="ansi"
		fi
	fi

	cat > "$EXPORTS_FILE" <<-EOF
		# Generated by \`theme\` — do not edit. Sourced from .zshrc.
		export THEME_NAME="$t"
		export THEME_LABEL="$label"
		export THEME_POLARITY="$polarity"
		export BAT_THEME="$bat_theme"
		# delta picks up BAT_THEME automatically for syntax highlighting.
		export DELTA_FEATURES="+side-by-side"
		export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline $fzf_opts"
	EOF
	ok "shell    → bat/fzf/delta exports written"
}

# Replace the JSON string value of `"key": "..."` on its own line. Settings
# files here are JSONC (comments), so jq cannot touch them.
jsonc_set_string() {
	local file="$1" key="$2" value="$3"
	grep -q "\"$key\"" "$file" || return 1
	local esc="${value//\\/\\\\}"
	esc="${esc//&/\\&}"
	esc="${esc//\//\\/}"
	sed -i "s/\"$key\": \"[^\"]*\"/\"$key\": \"$esc\"/" "$file"
}

# --- VS Code ----------------------------------------------------------------
# VS Code follows GNOME light/dark (autoDetectColorScheme stays on), so the
# catalog theme lands in the preferred slot for its polarity rather than in
# workbench.colorTheme — apply_gnome then flips the desktop to that polarity,
# which is what makes the change visible. The icon theme is owned by
# kd-vscode-icon-sync (mocha/latte tracking GNOME) and is never written here:
# icons follow light/dark only, not the theme family.
apply_vscode() {
	local t="$1" name="${TH_vscode:-}" polarity="${TH_polarity:-}"
	[ -n "$name" ] || return 0

	local file="$CONFIG/Code/User/settings.json"
	[ -f "$file" ] || return 0

	sed -i 's/"window.autoDetectColorScheme": false/"window.autoDetectColorScheme": true/' "$file"

	local key="workbench.preferredDarkColorTheme"
	[ "$polarity" = "light" ] && key="workbench.preferredLightColorTheme"
	if ! jsonc_set_string "$file" "$key" "$name"; then
		sed -i "/\"window.autoDetectColorScheme\":/a\\  \"$key\": \"$name\"," "$file"
	fi
	ok "vscode   → $name (preferred $polarity)"
}

# --- Zed --------------------------------------------------------------------
apply_zed() {
	local t="$1" name="${TH_zed:-}" polarity="${TH_polarity:-}"
	[ -n "$name" ] || return 0

	local file="$CONFIG/zed/settings.json"
	[ -f "$file" ] || return 0

	local mode="dark"
	[ "$polarity" = "light" ] && mode="light"

	jsonc_set_string "$file" "mode" "$mode" || true
	if [ "$mode" = "light" ]; then
		jsonc_set_string "$file" "light" "$name" || true
	else
		jsonc_set_string "$file" "dark" "$name" || true
	fi
	ok "zed      → $name"
}

# --- GNOME ------------------------------------------------------------------
# Flip the desktop light/dark preference to the theme's polarity so VS Code
# (autoDetectColorScheme) and the icon watcher follow along. Skipped on
# `theme reload`: a chezmoi apply must never flip a mode the user set by hand
# in GNOME — only an explicit theme switch does.
apply_gnome() {
	local t="$1" polarity="${TH_polarity:-}"
	[ "$RELOAD" -eq 1 ] && return 0
	has gsettings || return 0

	local scheme="prefer-dark"
	[ "$polarity" = "light" ] && scheme="prefer-light"
	gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || return 0
	ok "gnome    → $scheme"
}

# --- Hyprland (stub for the future HyDE setup) ------------------------------
apply_hyprland() {
	local t="$1"
	local dir="$CONFIG/hypr"
	[ -d "$dir" ] || return 0

	local family="${TH_family:-}" variant="${TH_variant:-}" polarity="${TH_polarity:-}"

	cat > "$dir/theme.conf" <<-EOF
		# Generated by \`theme\` — do not edit.
		\$theme_name = $t
		\$theme_family = $family
		\$theme_variant = $variant
		\$theme_polarity = $polarity
	EOF
	has hyprctl && hyprctl reload >/dev/null 2>&1 || true
	ok "hyprland → $t"
}

# ============================================================================
#  Commands
# ============================================================================

cmd_set() {
	local t="${1:-}"
	[ -n "$t" ] || die "usage: theme set <name>"

	# One jq pass populates TH_* for every applier below, and doubles as the
	# existence check.
	load_theme "$t" || {
		printf '%serror%s unknown theme: %s\n\n' "$C_RED" "$C_RESET" "$t" >&2
		cmd_list >&2
		exit 1
	}

	mkdir -p "$THEME_DIR"
	printf '%s\n' "$t" > "$CURRENT_FILE"

	say ""
	say "${C_BOLD}${TH_label:-$t}${C_RESET} ${C_DIM}($t)${C_RESET}"

	apply_ghostty  "$t"
	apply_tmux     "$t"
	apply_nvim     "$t"
	apply_druk     "$t"
	apply_vscode   "$t"
	apply_zed      "$t"
	apply_starship "$t"
	apply_exports  "$t"
	# Last on purpose: VS Code's preferred-theme slots must already be written
	# when the colour-scheme change event reaches it.
	apply_gnome    "$t"
	apply_hyprland "$t"

	say ""
	info "already-open shells: run  ${C_BOLD}exec zsh${C_RESET}${C_DIM}  to pick up the new colours"
	say ""
}

# One jq pass emits the whole table; the previous version cost two per theme.
theme_table() {
	jq -r '.order[] as $k | .themes[$k]
		| [$k, .label, .polarity] | @tsv' "$CATALOG"
}

cmd_list() {
	local cur; cur="$(current_theme)"
	printf '\n%sAvailable themes%s\n\n' "$C_BOLD" "$C_RESET"
	local t label polarity marker
	while IFS=$'\t' read -r t label polarity; do
		marker="  "
		[ "$t" = "$cur" ] && marker="${C_GREEN}▸ ${C_RESET}"
		printf '%s%-22s %s%-22s %s%s\n' \
			"$marker" "$t" "$C_DIM" "$label" "$polarity" "$C_RESET"
	done < <(theme_table)
	printf '\n'
}

cmd_pick() {
	local cur; cur="$(current_theme)"
	if has fzf; then
		local choice
		# Label and polarity are shown inline rather than in a --preview: the
		# preview forked a shell and a jq on every cursor move, for three
		# fields that fit on the line itself.
		choice="$(theme_table \
			| awk -F'\t' '{ printf "%-22s %-22s %s\n", $1, $2, $3 }' \
			| fzf --prompt='theme ❯ ' \
				--height=40% --layout=reverse --border \
				--header="current: $cur" \
			| awk '{ print $1 }')" || exit 0
		[ -n "$choice" ] && cmd_set "$choice"
	else
		cmd_list
		printf 'Enter a theme name: '
		local choice; read -r choice
		[ -n "$choice" ] && cmd_set "$choice"
	fi
}

cmd_next() {
	local cur next
	cur="$(current_theme)"
	next="$(all_themes | awk -v c="$cur" '
		{ a[NR] = $0; if ($0 == c) found = NR }
		END { print (found && found < NR) ? a[found + 1] : a[1] }')"
	cmd_set "$next"
}

cmd_toggle() {
	# Flip polarity, staying inside the same family where possible.
	local cur; cur="$(current_theme)"
	load_theme "$cur" || die "current theme '$cur' is not in the catalog"

	local want="dark"
	[ "${TH_polarity:-}" = "dark" ] && want="light"

	# Single ranked query: same-family candidates first, then any match.
	local target
	target="$(jq -r --arg f "${TH_family:-}" --arg p "$want" '
		[ .order[] as $k
		  | select(.themes[$k].polarity == $p)
		  | { k: $k, same: (.themes[$k].family == $f) } ]
		| (map(select(.same)) + .)[0].k // empty' "$CATALOG")"

	[ -n "$target" ] || die "no $want theme available"
	cmd_set "$target"
}

usage() {
	# A heredoc rather than `sed -n '3,20p' "$0"`: line-number slicing silently
	# truncates --help the moment the header comment gains a line.
	cat <<-'EOF'
		theme — switch the colour scheme of the whole environment at once.

		  theme                 interactive picker (fzf, or a numbered menu)
		  theme <name>          switch to a theme
		  theme set <name>      same, explicit
		  theme list            show every available theme
		  theme current         print the active theme
		  theme next            cycle to the next theme in the catalog
		  theme toggle          flip between the last dark and last light theme
		  theme reload          re-apply the current theme (after a config change)

		Flags:
		  -q, --quiet           only print warnings and errors
		  -h, --help            show this help

		Covers: Ghostty · tmux · Neovim · druk · VS Code · Zed · Starship ·
		        bat · fzf · delta · GNOME light/dark · Hyprland.
		        Everything that can reload live, does. VS Code icons stay on
		        catppuccin mocha/latte tracking GNOME (kd-vscode-icon-sync).
	EOF
}

# ============================================================================
#  Entry point
# ============================================================================

ARGS=()
for arg in "$@"; do
	case "$arg" in
		-q|--quiet) QUIET=1 ;;
		-h|--help)  usage; exit 0 ;;
		*)          ARGS+=("$arg") ;;
	esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

case "${1:-}" in
	"")        cmd_pick ;;
	set)       shift; cmd_set "${1:-}" ;;
	list|ls)   cmd_list ;;
	current)   current_theme ;;
	next)      cmd_next ;;
	toggle)    cmd_toggle ;;
	reload)    RELOAD=1; cmd_set "$(current_theme)" ;;
	*)         cmd_set "$1" ;;
esac
